{
  "name": "ihda-web",
  "version": "1.0.0",
  "private": true,
  "description": "Integration Health Dashboard - Next.js frontend and same-origin proxy service",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
